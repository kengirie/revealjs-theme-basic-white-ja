{
  "name": "revealjs-theme-basic-white-ja",
  "version": "0.1.0",
  "description": "Keynote の「ベーシックホワイト」風の reveal.js テーマ（日本語・ヒラギノ角ゴ）。Apple Inc. とは無関係です。",
  "license": "MIT",
  "author": "kengirie",
  "type": "module",
  "keywords": [
    "reveal.js",
    "revealjs",
    "reveal.js-theme",
    "reveal.js-plugin",
    "theme",
    "keynote",
    "japanese",
    "slides"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kengirie/revealjs-theme-basic-white-ja.git"
  },
  "homepage": "https://github.com/kengirie/revealjs-theme-basic-white-ja#readme",
  "bugs": {
    "url": "https://github.com/kengirie/revealjs-theme-basic-white-ja/issues"
  },
  "main": "./theme/basic-white.js",
  "exports": {
    ".": "./theme/basic-white.js",
    "./layouts": "./theme/layouts.js",
    "./basic-white.css": "./theme/basic-white.css",
    "./theme/*": "./theme/*",
    "./package.json": "./package.json"
  },
  "files": [
    "theme/"
  ],
  "scripts": {
    "start": "node scripts/serve.mjs",
    "reference": "osascript scripts/build-reference.applescript \"$PWD/keynote/png\" \"$PWD/test/media\"",
    "verify": "node scripts/screenshot.mjs test/compare.html keynote/reveal-out && python3 scripts/compare.py keynote/png keynote/reveal-out keynote/diff",
    "verify:autofit": "sh scripts/verify-autofit.sh",
    "screenshot": "node scripts/screenshot.mjs index.html out"
  },
  "peerDependencies": {
    "reveal.js": ">=5"
  },
  "devDependencies": {
    "playwright": "^1.50.0",
    "reveal.js": "^6.0.2"
  }
}
